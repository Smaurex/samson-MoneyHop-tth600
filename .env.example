# Copy this file to .env and fill in values once the backend/API is added.

# Base URL of our own backend (if we build one), e.g. http://localhost:3001/api
VITE_API_BASE_URL=

# API key for a currency provider, if the chosen one requires it
# (e.g. ExchangeRate-API). Not needed for Frankfurter.
VITE_CURRENCY_API_KEY=
