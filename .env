# Copy this file to .env and adjust if needed.

# Base URL of the backend in backend/ (run `npm start` inside that folder)
VITE_API_BASE_URL=http://localhost:3000/api

# API key for a currency provider, if the chosen one requires it
# (e.g. ExchangeRate-API). Not needed for Frankfurter. Rates are still
# mock data for now — this is unrelated to the conversions backend above.
VITE_CURRENCY_API_KEY=
